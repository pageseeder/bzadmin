<?xml version="1.0" encoding="UTF-8"?>
<!--
  Classpath group stylesheet for 'fixture': never used, because the filesystem stylesheet
  `WEB-INF/xslt/html/fixture.xsl` of the host takes precedence.
-->
<xsl:stylesheet version="2.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">

<xsl:output method="html" encoding="utf-8"/>

<xsl:template match="/">
<html>
  <body>
    <p id="classpath">fixture-classpath-group</p>
  </body>
</html>
</xsl:template>

</xsl:stylesheet>
