<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE services PUBLIC "-//Berlioz//DTD::Services 1.0//EN" "http://www.pageseeder.org/schema/berlioz/services-1.0.dtd">
<!--
  Berlioz Administration pages

  Every generator checks the verdict of org.pageseeder.bzadmin.access.AdminFilter, which the host maps to these URLs:
  the generators of Berlioz are used through org.pageseeder.bzadmin.guard.
  Every operation is a POST service of the internal API (/bzadmin/api/), which the filter only accepts from the admin
  pages of users who can operate.
-->
<services group="bzadmin">

  <!-- BERLIOZ CONFIG ======================================================================== -->

  <service id="bzadmin-config" method="get">
    <url pattern="/bzadmin/config"/>
    <generator class="org.pageseeder.bzadmin.guard.berlioz.generator.GetGlobalConfig"       name="global-config"        target="main"/>
    <generator class="org.pageseeder.bzadmin.guard.berlioz.generator.ListBerliozOptions"    name="berlioz-options"      target="main"/>
    <generator class="org.pageseeder.bzadmin.guard.berlioz.generator.GetBerliozConfig"       name="berlioz-config"       target="main"/>
    <generator class="org.pageseeder.bzadmin.guard.berlioz.generator.GetErrorHandlerConfig"  name="error-handler-config" target="main"/>
    <generator class="org.pageseeder.bzadmin.berlioz.GetBerliozControl"        name="berlioz-control"      target="main"/>
  </service>

  <service id="bzadmin-services" method="get">
    <url pattern="/bzadmin/services"/>
    <generator class="org.pageseeder.bzadmin.guard.berlioz.generator.ListRuntimeServices" name="runtime-services" target="main"/>
    <generator class="org.pageseeder.bzadmin.berlioz.GetBerliozControl"     name="berlioz-control"  target="main"/>
  </service>

  <!-- The service matching a Berlioz path ('url', without context path or extension) and HTTP 'method' (default GET) -->
  <service id="bzadmin-services-lookup" method="get">
    <url pattern="/bzadmin/services/lookup"/>
    <generator class="org.pageseeder.bzadmin.guard.berlioz.generator.GetMatchingService" name="service-match" target="main"/>
  </service>

  <!-- CACHE ================================================================================= -->

  <!-- A cache is named by provider, manager and cache (parameters `provider`, `manager`, `cache`):
       see docs/implementation/cache-contract.md -->

  <service id="bzadmin-cache-summary" method="get">
    <url pattern="/bzadmin/cache" />
    <generator class="org.pageseeder.bzadmin.cache.ListCaches"         name="cache-overview" target="main" />
  </service>

  <service id="bzadmin-cache-info" method="get">
    <url pattern="/bzadmin/cache/info" />
    <generator class="org.pageseeder.bzadmin.cache.GetCacheInfo"       name="cache-info" target="main" />
  </service>

  <service id="bzadmin-cache-entries" method="get">
    <url pattern="/bzadmin/cache/entries" />
    <generator class="org.pageseeder.bzadmin.cache.ListCacheEntries"   name="cache-entries" target="main" />
  </service>

  <!-- FILES ================================================================================= -->

  <!-- One folder at a time, with bounded work: the tree loads the folders on demand -->
  <service id="bzadmin-files" method="get">
    <url pattern="/bzadmin/files" />
    <generator class="org.pageseeder.bzadmin.psml.ListPsmlFolder"  name="files"           target="main" />
  </service>

  <service id="bzadmin-files-folders" method="get">
    <url pattern="/bzadmin/files/folders" />
    <generator class="org.pageseeder.bzadmin.psml.ListPsmlFolder"  name="files-folders"   target="main">
      <parameter name="folders" value="true"/>
    </generator>
  </service>

  <service id="bzadmin-files-document" method="get">
    <url pattern="/bzadmin/files/document" />
    <generator class="org.pageseeder.bzadmin.psml.GetPsmlDocument" name="files-document"  target="main" />
  </service>

  <!-- XSLT ================================================================================= -->

  <service id="bzadmin-xslt" method="get">
    <url pattern="/bzadmin/xslt" />
    <generator class="org.pageseeder.bzadmin.xslt.ListXsltFiles"       name="xslt"        target="main" />
    <generator class="org.pageseeder.bzadmin.berlioz.GetBerliozControl" name="berlioz-control" target="main" />
  </service>

  <service id="bzadmin-xslt-doc" method="get">
    <url pattern="/bzadmin/xslt/doc" />
    <generator class="org.pageseeder.bzadmin.xslt.GetXsltDocumentation" name="xslt-doc"    target="main" />
  </service>

  <service id="bzadmin-xslt-source" method="get">
    <url pattern="/bzadmin/xslt/source" />
    <generator class="org.pageseeder.bzadmin.xslt.GetXsltSource"       name="xslt-source" target="main" />
  </service>

  <!-- SYSTEM ================================================================================ -->

  <!-- The threads are listed on demand (system/threads) -->
  <service id="bzadmin-system" method="get">
    <url pattern="/bzadmin/system" />
    <generator class="org.pageseeder.bzadmin.system.GetSystemSummary"                name="system-summary" target="main"/>
    <generator class="org.pageseeder.bzadmin.guard.berlioz.system.GetRuntimeInfo"    name="runtime"     target="main"/>
    <generator class="org.pageseeder.bzadmin.guard.berlioz.system.GetFileSystemInfo" name="filesystem"  target="main"/>
    <!-- Values of sensitive names redacted -->
    <generator class="org.pageseeder.bzadmin.guard.berlioz.system.GetSystemProperties" name="sysproperties" target="main"/>
  </service>

  <service id="bzadmin-system-files" method="get">
    <url pattern="/bzadmin/system/files" />
    <generator class="org.pageseeder.bzadmin.guard.berlioz.system.GetFileSystemInfo" name="filesystem"  target="main"/>
  </service>

  <!-- The threads with their origin and activity, without stack (bounded: 2000 threads) -->
  <service id="bzadmin-system-threads" method="get">
    <url pattern="/bzadmin/system/threads" />
    <generator class="org.pageseeder.bzadmin.system.ListThreads" name="threads"  target="main"/>
  </service>

  <!-- One thread and its stack (bounded: 256 frames) -->
  <service id="bzadmin-system-thread" method="get">
    <url pattern="/bzadmin/system/thread" />
    <generator class="org.pageseeder.bzadmin.system.GetThreadInfo" name="thread"  target="main"/>
  </service>

  <!-- The Recent view, or the Files view with view=files (bzadmin/logs.xsl) -->
  <service id="bzadmin-logs" method="get">
    <url pattern="/bzadmin/logs" />
    <!-- The registered log files, by ID -->
    <generator class="org.pageseeder.bzadmin.log.ListLogFiles" name="logs-files"   target="main"/>
    <!-- The recent events captured by the logging adapter (logback), if any -->
    <generator class="org.pageseeder.bzadmin.log.GetRecentEvents"  name="logs-recent"  target="main"/>
  </service>

  <service id="bzadmin-logs-raw" method="get">
    <url pattern="/bzadmin/logs/raw" />
    <!-- Only the listed log files, by ID, with bounded work -->
    <generator class="org.pageseeder.bzadmin.log.GetLogEntries" name="logs-raw"  target="main"/>
  </service>

  <service id="bzadmin-logs-recent" method="get">
    <url pattern="/bzadmin/logs/recent" />
    <generator class="org.pageseeder.bzadmin.log.GetRecentEvents" name="logs-recent"  target="main"/>
  </service>

  <!-- Service parameters take precedence over request parameters: GET requests never reset the statistics -->
  <service id="bzadmin-application" method="get">
    <url pattern="/bzadmin/application" />
    <!-- Versions, detected integrations and reload status: no paths or configured values -->
    <generator class="org.pageseeder.bzadmin.application.GetApplicationSummary" name="summary"  target="main"/>
    <generator class="org.pageseeder.bzadmin.guard.berlioz.system.GetGeneratorStatistics" name="statistics"  target="main">
      <parameter name="reset" value="false"/>
    </generator>
    <generator class="org.pageseeder.bzadmin.guard.berlioz.system.ListLibraries"     name="libraries"   target="main"/>
  </service>

  <service id="bzadmin-application-statistics" method="get">
    <url pattern="/bzadmin/application/statistics" />
    <generator class="org.pageseeder.bzadmin.guard.berlioz.system.GetGeneratorStatistics" name="statistics"  target="main">
      <parameter name="reset" value="false"/>
    </generator>
  </service>

  <!-- INTERNAL API ========================================================================== -->

  <!--
    The data the admin pages read or change by script: direct services (<handler>), whose response is
    the output of their generator only, in XML or JSON (no envelope, no XSLT, whatever the extension).
    They are internal to bzadmin: hosts should not rely on them. Every operation is a POST service.
  -->

  <!-- Live samples -->

  <!-- The recent rates of the cache information page -->
  <service id="bzadmin-api-cache-info" method="get">
    <url pattern="/bzadmin/api/cache/info" />
    <handler class="org.pageseeder.bzadmin.cache.GetCacheInfo"/>
  </service>

  <!-- The live poll of the memory -->
  <service id="bzadmin-api-system-runtime" method="get">
    <url pattern="/bzadmin/api/system/runtime" />
    <handler class="org.pageseeder.bzadmin.guard.berlioz.system.GetRuntimeInfo"/>
  </service>

  <!-- The live poll of the CPU -->
  <service id="bzadmin-api-system-cpu" method="get">
    <url pattern="/bzadmin/api/system/cpu" />
    <handler class="org.pageseeder.bzadmin.guard.berlioz.system.GetCpuSample"/>
  </service>

  <!-- Berlioz controls -->

  <!--
    Berlioz applies 'berlioz-reload' before the service runs, which the filter authorises for these services only
    (see AdminFilter.CONTROL_SERVICES): the response says if it was authorised and the load status of the services;
    the X-Berlioz-Reload header lists the scopes Berlioz applied
  -->

  <!-- Everything with 'berlioz-reload=true' (configuration, services, XSLT cache, ETags, redirects) -->
  <service id="bzadmin-api-config-reload" method="post">
    <url pattern="/bzadmin/api/config/reload"/>
    <handler class="org.pageseeder.bzadmin.berlioz.GetBerliozControl"/>
  </service>

  <!-- The services with 'berlioz-reload=services' -->
  <service id="bzadmin-api-services-reload" method="post">
    <url pattern="/bzadmin/api/services/reload"/>
    <handler class="org.pageseeder.bzadmin.berlioz.GetBerliozControl"/>
  </service>

  <!-- The XSLT cache with 'berlioz-reload=xslt' -->
  <service id="bzadmin-api-xslt-cache-clear" method="post">
    <url pattern="/bzadmin/api/xslt/cache/clear" />
    <handler class="org.pageseeder.bzadmin.berlioz.GetBerliozControl"/>
  </service>

  <!-- Cache operations: see docs/design/cache-contract.md -->

  <!-- One cache, or every cache without parameters -->
  <service id="bzadmin-api-cache-clear" method="post">
    <url pattern="/bzadmin/api/cache/clear" />
    <handler class="org.pageseeder.bzadmin.cache.ClearCache"/>
  </service>

  <service id="bzadmin-api-cache-statistics" method="post">
    <url pattern="/bzadmin/api/cache/statistics" />
    <handler class="org.pageseeder.bzadmin.cache.SetCacheStatistics"/>
  </service>

  <service id="bzadmin-api-cache-statistics-reset" method="post">
    <url pattern="/bzadmin/api/cache/statistics/reset" />
    <handler class="org.pageseeder.bzadmin.cache.ResetCacheStatistics"/>
  </service>

  <service id="bzadmin-api-cache-entry-remove" method="post">
    <url pattern="/bzadmin/api/cache/entries/remove" />
    <handler class="org.pageseeder.bzadmin.cache.RemoveCacheEntry"/>
  </service>

  <!-- Other operations -->

  <!-- The capture threshold of the recent events, not the levels of the application's loggers -->
  <service id="bzadmin-api-logs-recent-threshold" method="post">
    <url pattern="/bzadmin/api/logs/recent/threshold" />
    <handler class="org.pageseeder.bzadmin.log.SetRecentEventsThreshold"/>
  </service>

  <service id="bzadmin-api-application-statistics-reset" method="post">
    <url pattern="/bzadmin/api/application/statistics/reset" />
    <handler class="org.pageseeder.bzadmin.guard.berlioz.system.GetGeneratorStatistics">
      <parameter name="reset" value="true"/>
    </handler>
  </service>

</services>
