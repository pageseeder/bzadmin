<?xml version="1.0"?>
<!--
  Global configuration of the local dev server (berlioz.mode=local): the Berlioz options, plus
  application properties to show on the Config page (grouped by prefix, nested names, and
  sensitive names that GetGlobalConfig redacts).
-->
<global>

  <berlioz>
    <errors handle="false" generator-catch="false"/>
    <http cache-control="private, max-age=0, must-revalidate"/>
    <xml parse-strict="true" header.version="1.0"/>
    <xslt cache="false"/>
    <nonce enable="true"/>
    <!-- Control parameters (berlioz-reload) from this machine, for the admin buttons -->
    <control network="loopback"/>
  </berlioz>

  <app name="bzadmin-dev" environment="local" base-url="https://localhost:8444">
    <search max-results="50" default-sort="relevance"/>
    <upload max-size="10485760" allowed-types="image/png,image/jpeg,application/pdf"/>
  </app>

  <mail host="smtp.example.org" port="587" from="noreply@example.org" username="mailer" password="local-mail-password">
    <tls enable="true"/>
  </mail>

  <pageseeder host="ps.example.org" scheme="https" port="443" group="demo-dev">
    <oauth client-id="bzadmin-local" client-secret="local-client-secret" token="local-access-token"/>
  </pageseeder>

  <analytics enable="false" api-key="local-analytics-key"/>

</global>
