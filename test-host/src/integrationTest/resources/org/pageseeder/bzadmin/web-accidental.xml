<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test host: the overlay JAR included by a host that knows nothing of it, with no authentication, no
  admin filter, and a mode without global configuration (no berlioz.admin.* properties).
-->
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         metadata-complete="false"
         version="3.0">

  <display-name>Berlioz Admin (test host, accidental inclusion)</display-name>

  <context-param>
    <param-name>berlioz.mode</param-name>
    <param-value>test-accidental</param-value>
  </context-param>

</web-app>
