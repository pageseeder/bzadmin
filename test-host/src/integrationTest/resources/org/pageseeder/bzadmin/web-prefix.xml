<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test host mapped by prefix, the legacy setup: no Berlioz kickstart, so the host declares the Berlioz servlets
  itself, on /html/* and /xml/*, and maps the admin filter to the admin services of both.
-->
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         metadata-complete="false"
         version="3.0">

  <display-name>Berlioz Admin (test host mapped by prefix)</display-name>

  <listener>
    <listener-class>org.pageseeder.bzadmin.fixture.FixtureCacheManagers</listener-class>
  </listener>

  <filter>
    <filter-name>SecurityHeadersFilter</filter-name>
    <filter-class>org.pageseeder.bzadmin.SecurityHeadersFilter</filter-class>
  </filter>

  <filter>
    <filter-name>FixtureAuthentication</filter-name>
    <filter-class>org.pageseeder.bzadmin.fixture.FixtureAuthentication</filter-class>
  </filter>

  <filter>
    <filter-name>AdminFilter</filter-name>
    <filter-class>org.pageseeder.bzadmin.access.AdminFilter</filter-class>
  </filter>

  <filter-mapping>
    <filter-name>SecurityHeadersFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <filter-mapping>
    <filter-name>FixtureAuthentication</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <filter-mapping>
    <filter-name>AdminFilter</filter-name>
    <url-pattern>/html/bzadmin/*</url-pattern>
    <url-pattern>/xml/bzadmin/*</url-pattern>
  </filter-mapping>

  <servlet>
    <servlet-name>Initialiser</servlet-name>
    <servlet-class>org.pageseeder.berlioz.servlet.InitServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>

  <servlet>
    <servlet-name>ErrorHandlerServlet</servlet-name>
    <servlet-class>org.pageseeder.berlioz.servlet.ErrorHandlerServlet</servlet-class>
    <load-on-startup>2</load-on-startup>
  </servlet>

  <servlet>
    <servlet-name>BerliozHTML</servlet-name>
    <servlet-class>org.pageseeder.berlioz.servlet.BerliozServlet</servlet-class>
    <init-param>
      <param-name>stylesheet</param-name>
      <param-value>/xslt/html/{GROUP}.xsl</param-value>
    </init-param>
    <init-param>
      <param-name>content-type</param-name>
      <param-value>text/html;charset=utf-8</param-value>
    </init-param>
    <load-on-startup>3</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>BerliozHTML</servlet-name>
    <url-pattern>/html/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>BerliozXML</servlet-name>
    <servlet-class>org.pageseeder.berlioz.servlet.BerliozServlet</servlet-class>
    <init-param>
      <param-name>stylesheet</param-name>
      <param-value>/xslt/xml/{GROUP}.xsl</param-value>
    </init-param>
    <init-param>
      <param-name>content-type</param-name>
      <param-value>application/xml;charset=utf-8</param-value>
    </init-param>
    <load-on-startup>4</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>BerliozXML</servlet-name>
    <url-pattern>/xml/*</url-pattern>
  </servlet-mapping>

</web-app>
