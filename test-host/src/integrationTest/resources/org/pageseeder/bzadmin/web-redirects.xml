<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test host (RedirectsTest): the host authentication (FixtureAuthentication) and the admin filter, with
  Berlioz's RedirectFilter and RelocationFilter registered once per case of the Redirects view. The
  configuration files are written by the test into the deployed WEB-INF, before the first request.

  Every rule is under /fixture-redirect/ or /fixture-relocation/, so the filters on /* leave the admin
  pages alone.
-->
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         metadata-complete="false"
         version="3.0">

  <display-name>Berlioz Admin (test host, redirects and forwards)</display-name>

  <filter>
    <filter-name>SecurityHeadersFilter</filter-name>
    <filter-class>org.pageseeder.bzadmin.SecurityHeadersFilter</filter-class>
  </filter>

  <!-- Redirects: active, covering the reload operation -->
  <filter>
    <filter-name>Redirects</filter-name>
    <filter-class>org.pageseeder.berlioz.servlet.RedirectFilter</filter-class>
    <init-param><param-name>config</param-name><param-value>config/fixture-redirects.xml</param-value></init-param>
  </filter>

  <!-- Active, but not covering the reload operation -->
  <filter>
    <filter-name>RedirectsPartial</filter-name>
    <filter-class>org.pageseeder.berlioz.servlet.RedirectFilter</filter-class>
    <init-param><param-name>config</param-name><param-value>config/fixture-redirects-partial.xml</param-value></init-param>
  </filter>

  <!-- No config parameter: Berlioz 0.14.5 fails every request through it (NullPointerException), so it
       is mapped to its own path only -->
  <filter>
    <filter-name>RedirectsNoConfig</filter-name>
    <filter-class>org.pageseeder.berlioz.servlet.RedirectFilter</filter-class>
  </filter>

  <!-- The file does not exist -->
  <filter>
    <filter-name>RedirectsMissing</filter-name>
    <filter-class>org.pageseeder.berlioz.servlet.RedirectFilter</filter-class>
    <init-param><param-name>config</param-name><param-value>config/fixture-redirects-missing.xml</param-value></init-param>
  </filter>

  <!-- Unreadable: outside WEB-INF by parent segment, by a link out of WEB-INF, a directory, too large -->
  <filter>
    <filter-name>RedirectsOutside</filter-name>
    <filter-class>org.pageseeder.berlioz.servlet.RedirectFilter</filter-class>
    <init-param><param-name>config</param-name><param-value>../fixture-redirects-outside.xml</param-value></init-param>
  </filter>
  <filter>
    <filter-name>RedirectsLinkOut</filter-name>
    <filter-class>org.pageseeder.berlioz.servlet.RedirectFilter</filter-class>
    <init-param><param-name>config</param-name><param-value>config/fixture-redirects-link-out.xml</param-value></init-param>
  </filter>
  <filter>
    <filter-name>RedirectsDirectory</filter-name>
    <filter-class>org.pageseeder.berlioz.servlet.RedirectFilter</filter-class>
    <init-param><param-name>config</param-name><param-value>config</param-value></init-param>
  </filter>
  <filter>
    <filter-name>RedirectsTooLarge</filter-name>
    <filter-class>org.pageseeder.berlioz.servlet.RedirectFilter</filter-class>
    <init-param><param-name>config</param-name><param-value>config/fixture-redirects-large.xml</param-value></init-param>
  </filter>

  <!-- Active through a link that stays in WEB-INF -->
  <filter>
    <filter-name>RedirectsLinkIn</filter-name>
    <filter-class>org.pageseeder.berlioz.servlet.RedirectFilter</filter-class>
    <init-param><param-name>config</param-name><param-value>config/fixture-redirects-link-in.xml</param-value></init-param>
  </filter>

  <!-- Invalid: another DOCTYPE, permanent="true" (the DTD's value, not the schema's), not well-formed -->
  <!-- Active: a DOCTYPE with a Berlioz public identifier, which Berlioz removes -->
  <filter>
    <filter-name>RedirectsBerliozDoctype</filter-name>
    <filter-class>org.pageseeder.berlioz.servlet.RedirectFilter</filter-class>
    <init-param><param-name>config</param-name><param-value>config/fixture-redirects-berlioz-doctype.xml</param-value></init-param>
  </filter>
  <filter>
    <filter-name>RedirectsDoctype</filter-name>
    <filter-class>org.pageseeder.berlioz.servlet.RedirectFilter</filter-class>
    <init-param><param-name>config</param-name><param-value>config/fixture-redirects-doctype.xml</param-value></init-param>
  </filter>
  <filter>
    <filter-name>RedirectsPermanentTrue</filter-name>
    <filter-class>org.pageseeder.berlioz.servlet.RedirectFilter</filter-class>
    <init-param><param-name>config</param-name><param-value>config/fixture-redirects-permanent-true.xml</param-value></init-param>
  </filter>
  <filter>
    <filter-name>RedirectsMalformed</filter-name>
    <filter-class>org.pageseeder.berlioz.servlet.RedirectFilter</filter-class>
    <init-param><param-name>config</param-name><param-value>config/fixture-redirects-malformed.xml</param-value></init-param>
  </filter>

  <!-- Bounds: more rules than listed, a value longer than the bound -->
  <filter>
    <filter-name>RedirectsMany</filter-name>
    <filter-class>org.pageseeder.berlioz.servlet.RedirectFilter</filter-class>
    <init-param><param-name>config</param-name><param-value>config/fixture-redirects-many.xml</param-value></init-param>
  </filter>
  <filter>
    <filter-name>RedirectsLong</filter-name>
    <filter-class>org.pageseeder.berlioz.servlet.RedirectFilter</filter-class>
    <init-param><param-name>config</param-name><param-value>config/fixture-redirects-long.xml</param-value></init-param>
  </filter>

  <!-- Relocations: active, with targets in and out of the admin services -->
  <filter>
    <filter-name>Relocations</filter-name>
    <filter-class>org.pageseeder.berlioz.servlet.RelocationFilter</filter-class>
    <init-param><param-name>config</param-name><param-value>config/fixture-relocations.xml</param-value></init-param>
  </filter>

  <filter>
    <filter-name>FixtureAuthentication</filter-name>
    <filter-class>org.pageseeder.bzadmin.fixture.FixtureAuthentication</filter-class>
  </filter>

  <filter>
    <filter-name>AdminFilter</filter-name>
    <filter-class>org.pageseeder.bzadmin.access.AdminFilter</filter-class>
  </filter>

  <filter-mapping>
    <filter-name>SecurityHeadersFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <filter-mapping><filter-name>Redirects</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>RedirectsPartial</filter-name><url-pattern>/fixture-redirect/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>RedirectsNoConfig</filter-name><url-pattern>/fixture-no-config/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>RedirectsMissing</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>RedirectsOutside</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>RedirectsLinkOut</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>RedirectsDirectory</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>RedirectsTooLarge</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>RedirectsLinkIn</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>RedirectsBerliozDoctype</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>RedirectsDoctype</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>RedirectsPermanentTrue</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>RedirectsMalformed</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>RedirectsMany</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>RedirectsLong</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>Relocations</filter-name><url-pattern>/*</url-pattern></filter-mapping>

  <filter-mapping>
    <filter-name>FixtureAuthentication</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- The default mapping: direct requests only (no FORWARD), as documented -->
  <filter-mapping>
    <filter-name>AdminFilter</filter-name>
    <url-pattern>/bzadmin/*</url-pattern>
  </filter-mapping>

</web-app>
