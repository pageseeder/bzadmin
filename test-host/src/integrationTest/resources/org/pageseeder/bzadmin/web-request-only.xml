<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test host for the basic setup: authentication followed by AdminFilter, with default REQUEST dispatchers.
-->
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         metadata-complete="false"
         version="3.0">

  <display-name>Berlioz Admin (test host, request only)</display-name>

  <filter>
    <filter-name>FixtureAuthentication</filter-name>
    <filter-class>org.pageseeder.bzadmin.fixture.FixtureAuthentication</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>FixtureAuthentication</filter-name>
    <url-pattern>/bzadmin/*</url-pattern>
  </filter-mapping>

  <filter>
    <filter-name>AdminFilter</filter-name>
    <filter-class>org.pageseeder.bzadmin.access.AdminFilter</filter-class>
  </filter>

  <filter-mapping>
    <filter-name>AdminFilter</filter-name>
    <url-pattern>/bzadmin/*</url-pattern>
  </filter-mapping>

</web-app>
