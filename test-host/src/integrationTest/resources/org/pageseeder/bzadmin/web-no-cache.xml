<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test host without any cache library (warNoCacheHost): web.xml without the host's cache managers.
-->
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         metadata-complete="false"
         version="3.0">

  <display-name>Berlioz Admin (test host)</display-name>


  <filter>
    <filter-name>SecurityHeadersFilter</filter-name>
    <filter-class>org.pageseeder.bzadmin.SecurityHeadersFilter</filter-class>
  </filter>

  <filter>
    <filter-name>FixtureAuthentication</filter-name>
    <filter-class>org.pageseeder.bzadmin.fixture.FixtureAuthentication</filter-class>
  </filter>

  <filter>
    <filter-name>AdminFilter</filter-name>
    <filter-class>org.pageseeder.bzadmin.access.AdminFilter</filter-class>
  </filter>


  <filter-mapping>
    <filter-name>SecurityHeadersFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <filter-mapping>
    <filter-name>FixtureAuthentication</filter-name>
    <url-pattern>/*</url-pattern>
    <dispatcher>REQUEST</dispatcher>
    <dispatcher>FORWARD</dispatcher>
    <dispatcher>ERROR</dispatcher>
  </filter-mapping>

  <filter-mapping>
    <filter-name>AdminFilter</filter-name>
    <url-pattern>/bzadmin/*</url-pattern>
    <dispatcher>REQUEST</dispatcher>
    <dispatcher>FORWARD</dispatcher>
    <dispatcher>ERROR</dispatcher>
  </filter-mapping>

  <!-- A host servlet that forwards to the admin services -->
  <servlet>
    <servlet-name>FixtureForward</servlet-name>
    <servlet-class>org.pageseeder.bzadmin.fixture.FixtureForward</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>FixtureForward</servlet-name>
    <url-pattern>/fixture-forward/*</url-pattern>
  </servlet-mapping>

  <!-- Host servlets that include an admin service, and send errors whose pages are admin services
       (negative cases: the admin filter does not process includes, and processes error dispatches) -->
  <servlet>
    <servlet-name>FixtureInclude</servlet-name>
    <servlet-class>org.pageseeder.bzadmin.fixture.FixtureInclude</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>FixtureInclude</servlet-name>
    <url-pattern>/fixture-include/*</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>FixtureError</servlet-name>
    <servlet-class>org.pageseeder.bzadmin.fixture.FixtureError</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>FixtureError</servlet-name>
    <url-pattern>/fixture-error/*</url-pattern>
  </servlet-mapping>
  <error-page>
    <error-code>418</error-code>
    <location>/bzadmin/config.src</location>
  </error-page>
  <error-page>
    <error-code>451</error-code>
    <location>/bzadmin/cache/clear.src</location>
  </error-page>


</web-app>
